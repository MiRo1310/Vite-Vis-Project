{
  "name": "vite-project",
  "private": true,
  "version": "1.10.16",
  "type": "module",
  "web-types": "./web-types.json",
  "scripts": {
    "dev": "vite",
    "generate-pwa-assets": "pwa-assets-generator",
    "prebuild": "yarn generate-pwa-assets",
    "build": "vue-tsc && vite build",
    "build-production": "vue-tsc && vite build --mode production",
    "codegen": "graphql-codegen --config codegen.ts",
    "preview": "vite preview",
    "lint": "eslint --ext .ts,.vue src --fix",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e:open": "cypress open",
    "test:e2e:ci": "cypress run",
    "test:component:ci": "cypress run --component",
    "test:cypress:ci": "yarn run test:e2e:ci && yarn run test:component:ci",
    "release": "ts-node scripts/release.ts",
    "copy:local": "ts-node scripts/copy.ts"
  },
