{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "bundler",
    "types": ["cypress", "node", "@testing-library/cypress"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext"
  },
  "include": ["**/*.ts", "**/*.js"]
}
